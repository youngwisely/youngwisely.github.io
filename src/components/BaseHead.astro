---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description } = Astro.props;
const fullTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-sans" preload />

<link rel="canonical" href={canonicalURL} />
<title>{fullTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL('og.png', Astro.site)} />
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL('og.png', Astro.site)} />

<script type="application/ld+json" set:html={JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Younghyun Oh',
	url: 'https://youngwisely.github.io/',
	image: 'https://youngwisely.github.io/photo.jpg',
	jobTitle: 'Postdoctoral researcher',
	affiliation: {
		'@type': 'Organization',
		name: 'Center for Neuroscience Imaging Research, Institute for Basic Science / Sungkyunkwan University',
	},
	sameAs: [
		'https://orcid.org/0009-0000-1067-7793',
		'https://scholar.google.com/citations?user=I0_2hEUAAAAJ',
		'https://github.com/youngwisely',
		'https://x.com/oh_younghyun',
	],
})} />

<script is:inline>
	const stored = localStorage.getItem('theme');
	const theme = stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
	document.documentElement.dataset.theme = theme;
</script>
