---
import { SITE_TITLE, PROFILE_LINE, LOCATION, SOCIALS } from '../consts';

const links = [
	{ label: 'Email', href: `mailto:${SOCIALS.email}`, icon: 'mail', ext: false },
	{ label: 'Google Scholar', href: SOCIALS.scholar, icon: 'scholar', ext: true },
	{ label: 'ORCID', href: SOCIALS.orcid, icon: 'orcid', ext: true },
	{ label: 'GitHub', href: SOCIALS.github, icon: 'github', ext: true },
	{ label: 'X', href: SOCIALS.x, icon: 'x', ext: true },
	{ label: 'CV (PDF)', href: '/oh_cv.pdf', icon: 'file', ext: true },
];
---

<aside class="profile">
	<img class="portrait" src="/photo.jpg" alt="Younghyun Oh" width="400" height="400" />
	<p class="name">{SITE_TITLE}</p>
	<p class="line">{PROFILE_LINE}</p>
	<ul class="meta">
		<li>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z" /><circle cx="12" cy="10" r="2.6" /></svg>
			<span>{LOCATION}</span>
		</li>
		{
			links.map((l) => (
				<li>
					{l.icon === 'mail' && (
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
					)}
					{l.icon === 'scholar' && (
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 9.5 12 4 2 9.5l10 5.5 10-5.5z" /><path d="M6 12.2V17c3.2 2.8 8.8 2.8 12 0v-4.8" /><path d="M22 9.5v5" /></svg>
					)}
					{l.icon === 'orcid' && (
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9.5" /><path d="M8.6 9.4v6.2M8.6 6.6v.2" stroke-linecap="round" /><path d="M11.4 9.4h2.6a3.1 3.1 0 0 1 0 6.2h-2.6z" stroke-linejoin="round" /></svg>
					)}
					{l.icon === 'github' && (
						<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5z" /></svg>
					)}
					{l.icon === 'x' && (
						<svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.2 8.2L23 22h-6.6l-5.2-6.8L5.3 22H2.1l7.7-8.8L1.7 2h6.8l4.7 6.2L18.9 2zm-1.1 18h1.7L7.3 3.9H5.4L17.8 20z" /></svg>
					)}
					{l.icon === 'file' && (
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /><path d="M9 13h6M9 17h6" /></svg>
					)}
					<a href={l.href} target={l.ext ? '_blank' : undefined} rel={l.ext ? 'noopener' : undefined}>{l.label}</a>
				</li>
			))
		}
	</ul>
</aside>

<style>
	.profile {
		position: sticky;
		top: 5.5rem;
		align-self: start;
	}
	.portrait {
		display: block;
		width: 10.5rem;
		height: 10.5rem;
		border-radius: 50%;
		object-fit: cover;
		margin-bottom: 1rem;
	}
	.name {
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		margin: 0 0 0.3rem;
	}
	.line {
		font-size: 0.9rem;
		line-height: 1.45;
		color: var(--muted);
		margin: 0 0 1.1rem;
	}
	.meta {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		font-size: 0.88rem;
	}
	.meta li { display: flex; align-items: center; gap: 0.5rem; color: var(--muted); }
	.meta svg { width: 0.95rem; height: 0.95rem; flex: none; color: var(--muted); }
	.meta a { color: var(--text); text-decoration: none; }
	.meta a:hover { color: var(--accent); text-decoration: underline; }

	@media (max-width: 760px) {
		.profile {
			position: static;
			display: grid;
			grid-template-columns: auto 1fr;
			column-gap: 1.1rem;
			align-items: center;
			padding-bottom: 1.4rem;
			border-bottom: 1px solid var(--rule);
			margin-bottom: 1.6rem;
		}
		.portrait { width: 5.5rem; height: 5.5rem; margin: 0; grid-row: 1 / span 2; }
		.name { margin: 0; }
		.line { margin: 0; }
		.meta { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; gap: 0.4rem 1.1rem; margin-top: 0.9rem; }
	}
</style>
