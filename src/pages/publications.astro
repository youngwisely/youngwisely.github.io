---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SOCIALS } from '../consts';

const papers = (await getCollection('papers')).sort(
	(a, b) => b.data.year - a.data.year || b.data.order - a.data.order
);
---

<Base title="Publications" description="Publications by Younghyun Oh.">
	<h1>Publications</h1>
	<p class="small muted">
		Author contributions noted per entry. See also <a href={SOCIALS.scholar} target="_blank" rel="noopener">Google Scholar</a>.
	</p>

	{
		papers.map((p) => (
			<article class="entry">
				<div class="entry-title">{p.data.title}</div>
				<div class="entry-sub" set:html={p.data.authors} />
				<div class="entry-meta">
					<em>{p.data.venue}</em>, {p.data.year}
					{p.data.status && <> · {p.data.status}</>}
				</div>
				{(p.data.paperurl || p.data.links.length > 0) && (
					<p class="links-inline">
						{p.data.links.map((l) => (
							<a href={l.href} target="_blank" rel="noopener">{l.label}</a>
						))}
						{p.data.paperurl && (
							<a href={p.data.paperurl} target="_blank" rel="noopener">Publisher</a>
						)}
					</p>
				)}
			</article>
		))
	}
</Base>
